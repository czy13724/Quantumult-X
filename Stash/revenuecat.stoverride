name: |-
  revenuecat合集
desc: |-
  远程引用（每一个下载地址对应一个UAMappings）

http:

  mitm:
    - "api.revenuecat.com"

  script:  
  - match: ^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$)
    name: revenuecat合集_84
    type: response
    require-body: true
    max-size: -1
    timeout: 60
    script: revenuecat合集_84
  
  - match: ^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$)
    name: revenuecat合集_84
    type: request
    require-body: true
    max-size: -1
    timeout: 60
    script: revenuecat合集_84


script-providers:
  "revenuecat合集_84":
    url: https://raw.githubusercontent.com/czy13724/Quantumult-X/main/scripts/Revenuecat.js
    interval: 86400

